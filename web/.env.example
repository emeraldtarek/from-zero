# --- Chat authentication ---
# Pick ONE of the two below. Tool use (auto-glossary, auto-Q&A, auto-promotion,
# auto-progress-log) only works with ANTHROPIC_API_KEY.
#
# Direct API key (preferred — unlocks tool use):
ANTHROPIC_API_KEY=
#
# OR a long-lived OAuth token from `claude setup-token` (uses your Claude Code
# Max subscription; tool use is NOT exposed via this path):
CLAUDE_CODE_OAUTH_TOKEN=

# Path to the curriculum corpus. Defaults to ../zero
LITHIUM_CONTENT_DIR=../zero

# SQLite database file path (relative to web/)
LITHIUM_DB_PATH=./data/lithium.db

# Default model used by the chat
LITHIUM_MODEL=claude-sonnet-4-5-20250929
