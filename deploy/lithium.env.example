# /etc/lithium/lithium.env — copied here by bootstrap.sh
# chmod 600, owned by the `lithium` user.
#
# DO NOT commit a filled-in copy of this file to git.

# --- Next.js runtime ---
NODE_ENV=production
PORT=3717
NEXT_TELEMETRY_DISABLED=1

# --- Lithium app ---
# Persistent state (writable by the `lithium` user). Seeded on first deploy
# from the repo's zero/ directory; thereafter the server copy is live.
LITHIUM_CONTENT_DIR=/var/lib/lithium/zero
LITHIUM_DB_PATH=/var/lib/lithium/data/lithium.db
LITHIUM_MODEL=claude-sonnet-4-5-20250929

# --- Chat auth (pick ONE) ---
# Long-lived OAuth token from `claude setup-token` on your laptop.
# Uses your Claude Code Max subscription. Tool use is NOT exposed via this path.
CLAUDE_CODE_OAUTH_TOKEN=

# Direct Anthropic API key. Unlocks tool use (auto-glossary, auto-Q&A, etc.).
# If both are set, ANTHROPIC_API_KEY wins.
ANTHROPIC_API_KEY=
